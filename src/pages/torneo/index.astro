---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { breadcrumb } from "../../data/seo";
import { avisoTorneo } from "../../data/event";

const structuredData = [breadcrumb([{ name: "Torneo", path: "/torneo/" }])];
---

<BaseLayout
  title="El cuadro | La Copa Arena"
  description="Calendario, resultados y clasificación de La Copa Arena en Playa O Pozo."
  structuredData={structuredData}
>
  <SiteHeader />

  <main class="legal-page torneo-page" data-torneo>
    <section class="legal-hero">
      <p class="eyebrow reveal">Torneo</p>
      <h1 class="reveal" style="--reveal-delay: 90ms">El cuadro</h1>
      <p class="reveal" style="--reveal-delay: 180ms" data-torneo-lede>
        Quién juega, contra quién y cómo va. Se actualiza solo mientras hay partido.
      </p>
    </section>

    {/*
      El marcador ya no vive aquí: es su propia página, /directo/, y enseña solo
      el partido que se está jugando. Lo que queda es la puerta, y solo mientras
      hay alguien en pista.
    */}
    <p class="torneo-directo" data-torneo-directo hidden aria-live="polite">
      Se está jugando ahora: <a href="/directo/" data-torneo-directo-enlace>ver el directo</a>
    </p>

    {/*
      Va en el marcado y no en torneo-page.js a propósito: explica por qué la
      tabla del grupo B no se lee como de costumbre, así que tiene que seguir
      ahí cuando /api/torneo falla y no pinta ninguna tabla. Las dos fichas
      repiten los colores que llevarán esas filas, para reconocerlas al llegar.
    */}
    <aside class="torneo-aviso">
      <p class="torneo-aviso-eyebrow">{avisoTorneo.eyebrow}</p>
      <h2>{avisoTorneo.titulo}</h2>
      {avisoTorneo.parrafos.map((parrafo) => <p>{parrafo}</p>)}
      <p class="torneo-aviso-fichas">
        <span class="torneo-aviso-ficha is-retirado">
          <span class="torneo-tabla-cruz" aria-hidden="true">✕</span>{avisoTorneo.equipos.fuera}
        </span>
        <span class="torneo-aviso-ficha is-directo">{avisoTorneo.equipos.dentro}</span>
      </p>
    </aside>

    <p class="teams-status" data-torneo-status aria-live="polite">Cargando el torneo…</p>
    <button type="button" class="button button-secondary" data-torneo-retry hidden>Reintentar</button>

    <div data-torneo-fases hidden></div>

    <section class="torneo-seccion" data-torneo-sueltos hidden>
      <h2>Otros partidos</h2>
      <p class="torneo-nota">Amistosos y repescas que no cuelgan de ninguna fase.</p>
      <div data-torneo-sueltos-lista></div>
    </section>
  </main>

  <SiteFooter />

  {/* directo.js ya lo carga BaseLayout: el botón de la cabecera lo necesita en todas las páginas. */}
  <script is:inline src="/assets/site-interactions.js" defer></script>
  <script is:inline src="/assets/match-utils.js" defer></script>
  <script is:inline src="/assets/torneo-page.js" defer></script>
</BaseLayout>
