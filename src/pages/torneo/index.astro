---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { breadcrumb } from "../../data/seo";

const structuredData = [breadcrumb([{ name: "Torneo", path: "/torneo/" }])];
---

<BaseLayout
  title="El cuadro | La Copa Arena"
  description="Calendario, resultados y clasificación de La Copa Arena en Playa O Pozo. El marcador del partido en juego, en directo."
  structuredData={structuredData}
>
  <SiteHeader />

  <main class="legal-page torneo-page" data-torneo>
    <section class="legal-hero">
      <p class="eyebrow reveal">Torneo</p>
      <h1 class="reveal" style="--reveal-delay: 90ms">El cuadro</h1>
      <p class="reveal" style="--reveal-delay: 180ms" data-torneo-lede>
        Quién juega, contra quién y cómo va. Se actualiza solo mientras hay partido.
      </p>
    </section>

    {/*
      El directo va arriba del todo y ocupa lo suyo: mientras hay alguien en
      pista es lo único que importa de esta página. Cuando no lo hay, se encoge
      a una línea en vez de dejar un hueco.
    */}
    <section class="directo-panel" id="directo" data-directo-panel aria-live="polite">
      <p class="directo-vacio" data-directo-panel-vacio>Ahora mismo no se está jugando nada.</p>
      <div data-directo-panel-partidos hidden></div>
      <button type="button" class="button button-secondary directo-refrescar" data-directo-refrescar hidden>
        Actualizar marcador
      </button>
    </section>

    <p class="teams-status" data-torneo-status aria-live="polite">Cargando el torneo…</p>
    <button type="button" class="button button-secondary" data-torneo-retry hidden>Reintentar</button>

    <div data-torneo-fases hidden></div>

    <section class="torneo-seccion" data-torneo-sueltos hidden>
      <h2>Otros partidos</h2>
      <p class="torneo-nota">Amistosos y repescas que no cuelgan de ninguna fase.</p>
      <div data-torneo-sueltos-lista></div>
    </section>
  </main>

  <SiteFooter />

  {/* directo.js ya lo carga BaseLayout: el botón de la cabecera lo necesita en todas las páginas. */}
  <script is:inline src="/assets/site-interactions.js" defer></script>
  <script is:inline src="/assets/match-utils.js" defer></script>
  <script is:inline src="/assets/torneo-page.js" defer></script>
</BaseLayout>
