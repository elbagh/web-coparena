---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Admin | La Copa Arena"
  description="Panel privado de administración de La Copa Arena."
  noindex={true}
>
  <SiteHeader />

  <main class="legal-page admin-page">
    <section class="legal-hero">
      <p class="eyebrow reveal">Privado</p>
      <h1 class="reveal" style="--reveal-delay: 90ms">Panel de administración</h1>
      <p class="reveal" style="--reveal-delay: 180ms">
        Gestión interna de equipos, jugadores y camisetas. Solo las cuentas marcadas como administradoras pueden ver estos datos.
      </p>
    </section>

    <section class="auth-card reveal" style="--reveal-delay: 220ms" data-auth-loading>
      <h2>Comprobando sesión...</h2>
    </section>

    <section class="auth-card reveal" style="--reveal-delay: 220ms" data-auth-logged-out hidden>
      <h2>Entra con Google</h2>
      <p>El panel solo se abre si tu usuario está marcado como administrador en la base de datos.</p>
      <p class="auth-error" data-auth-error hidden></p>
      <div class="google-login" data-google-login></div>
    </section>

    <section class="admin-shell reveal" style="--reveal-delay: 280ms" data-auth-logged-in data-admin hidden>
      <div class="teams-panel" data-admin-loading>
        <p class="teams-status">Cargando panel...</p>
      </div>

      <div class="form-banner" role="alert" data-admin-error hidden></div>

      <section class="admin-stats" data-admin-stats hidden aria-label="Resumen del torneo"></section>

      <section class="admin-grid" data-admin-content hidden>
        <article class="teams-panel admin-panel admin-panel-wide" data-admin-matches>
          <div class="admin-panel-head">
            <div>
              <p class="eyebrow">Partidos</p>
              <h2>Sorteo y marcador</h2>
              <p data-admin-status>Cargando equipos y partidos...</p>
            </div>
            <div class="admin-actions">
              <button class="add-player" type="button" data-load-teams>Actualizar equipos</button>
              <button class="button button-primary" type="button" data-draw>Sortear emparejamientos</button>
              <button class="button button-secondary" type="button" data-confirm-draw hidden>Confirmar sorteo</button>
            </div>
          </div>
          <form class="manual-team-form" data-match-team-form>
            <label class="field">
              <span>Equipo manual</span>
              <input type="text" name="team" placeholder="Nombre del equipo" autocomplete="off" />
            </label>
            <button class="add-player" type="submit">Anadir</button>
          </form>
          <div class="admin-team-pool" data-team-pool aria-live="polite"></div>
          <div class="matches-bracket-wrap" data-admin-bracket hidden></div>
          <div class="admin-match-list" data-match-list></div>
        </article>

        <article class="teams-panel admin-panel">
          <div class="admin-panel-head">
            <div>
              <p class="eyebrow">Equipos</p>
              <h2>Equipos registrados</h2>
            </div>
            <div class="admin-actions">
              <button type="button" class="add-player" data-admin-normalize>Normalizar nombres</button>
              <button type="button" class="add-player" data-admin-refresh>Actualizar</button>
            </div>
          </div>
          <div class="admin-list" data-admin-teams></div>
        </article>

        <article class="teams-panel admin-panel">
          <div class="admin-panel-head">
            <div>
              <p class="eyebrow">Camisetas</p>
              <h2>Reservas</h2>
            </div>
          </div>
          <form class="admin-shirt-form" data-admin-shirt-form novalidate>
            <div class="form-banner" data-admin-shirt-banner hidden></div>
            <div class="shirts-form-grid">
              <div class="field">
                <label for="admin-shirt-name">Nombre</label>
                <input id="admin-shirt-name" name="nombre" type="text" maxlength="80" autocomplete="name" data-admin-shirt-field="nombre" />
                <p class="field-error" data-admin-shirt-error="nombre" hidden></p>
              </div>
              <div class="field">
                <label for="admin-shirt-size">Talla</label>
                <select id="admin-shirt-size" name="talla" data-admin-shirt-field="talla">
                  <option value="">Elige talla</option>
                  <option value="XS">XS</option>
                  <option value="S">S</option>
                  <option value="M">M</option>
                  <option value="L">L</option>
                  <option value="XL">XL</option>
                  <option value="XXL">XXL</option>
                </select>
                <p class="field-error" data-admin-shirt-error="talla" hidden></p>
              </div>
              <div class="field">
                <label for="admin-shirt-quantity">Cantidad</label>
                <input id="admin-shirt-quantity" name="cantidad" type="number" min="1" max="10" step="1" value="1" data-admin-shirt-field="cantidad" />
                <p class="field-error" data-admin-shirt-error="cantidad" hidden></p>
              </div>
              <div class="field shirts-notes">
                <label for="admin-shirt-notes">Notas <span class="field-opt">opcional</span></label>
                <textarea id="admin-shirt-notes" name="notas" rows="3" maxlength="240" data-admin-shirt-field="notas"></textarea>
                <p class="field-error" data-admin-shirt-error="notas" hidden></p>
              </div>
            </div>
            <div class="admin-shirt-form-actions">
              <button type="submit" class="form-submit" data-admin-shirt-submit>Añadir reserva</button>
            </div>
          </form>
          <div class="admin-list" data-admin-shirts></div>
        </article>

        <article class="teams-panel admin-panel admin-panel-wide" data-admin-ediciones hidden>
          <div class="admin-panel-head">
            <div>
              <p class="eyebrow">Ediciones</p>
              <h2>Ediciones y resultados</h2>
              <p data-ediciones-status>Cargando ediciones...</p>
            </div>
          </div>

          <div class="form-banner" role="alert" data-ediciones-error hidden></div>

          <div class="ediciones-layout">
            <section class="ediciones-col">
              <h3 class="ediciones-subtitle">Ediciones de la Copa</h3>
              <div class="ediciones-list" data-ediciones-list aria-live="polite"></div>

              <form class="edicion-nueva" data-edicion-form novalidate>
                <p class="ediciones-subtitle">Crear una edición nueva</p>
                <div class="edicion-nueva-grid">
                  <div class="field">
                    <label for="edicion-anio">Año</label>
                    <input id="edicion-anio" name="anio" type="number" min="2000" max="2100" step="1"
                      inputmode="numeric" autocomplete="off" data-edicion-field="anio" />
                    <p class="field-error" data-edicion-error="anio" hidden></p>
                  </div>
                  <div class="field">
                    <label for="edicion-nombre">Nombre</label>
                    <input id="edicion-nombre" name="nombre" type="text" maxlength="60"
                      placeholder="Copa Arena 2027" autocomplete="off" data-edicion-field="nombre" />
                    <p class="field-error" data-edicion-error="nombre" hidden></p>
                  </div>
                </div>
                <button type="submit" class="add-player" data-edicion-submit>Crear edición</button>
              </form>
            </section>

            <section class="ediciones-col ediciones-col--wide">
              <h3 class="ediciones-subtitle">
                Puestos · <span data-resultados-edicion>edición actual</span>
              </h3>
              <p class="ediciones-hint">
                Escribe el puesto final de cada equipo. 1º, 2º y 3º forman el podio que aparece en la ficha de cada jugador.
                Deja el puesto vacío mientras la edición sigue en juego.
              </p>
              <div class="resultados-list" data-resultados-list aria-live="polite"></div>
            </section>
          </div>
        </article>
      </section>
    </section>
  </main>

  <dialog class="match-dialog" data-match-dialog>
    <form method="dialog" class="match-dialog-close">
      <button type="submit" aria-label="Cerrar">x</button>
    </form>
    <div class="match-dialog-body" data-dialog-body></div>
  </dialog>

  <dialog class="match-dialog" data-team-edit-dialog>
    <form method="dialog" class="match-dialog-close">
      <button type="submit" aria-label="Cerrar">x</button>
    </form>
    <div class="match-dialog-body">
      <div class="match-dialog-head">
        <p class="eyebrow">Editar equipo</p>
        <h2 data-team-edit-title>Equipo</h2>
      </div>

      <div class="form-banner" role="alert" data-team-edit-banner hidden></div>

      <form data-team-edit-form novalidate>
        <div class="field">
          <label for="team-edit-name">Nombre del equipo</label>
          <input id="team-edit-name" type="text" maxlength="60" autocomplete="off" data-team-edit-field="equipo" />
          <p class="field-error" data-team-edit-error="equipo" hidden></p>
        </div>

        <div class="players" data-team-edit-players></div>

        <button type="button" class="add-player" data-team-edit-add>+ Añadir jugador</button>

        <div class="admin-diff" data-team-edit-diff hidden>
          <h3>Vas a guardar estos cambios</h3>
          <ul data-team-edit-diff-list></ul>
        </div>

        <div class="admin-shirt-form-actions">
          <button type="button" class="button button-secondary" data-team-edit-review>Revisar cambios</button>
          <button type="button" class="button button-secondary" data-team-edit-back hidden>Volver a editar</button>
          <button type="button" class="button button-primary" data-team-edit-confirm hidden>Confirmar cambios</button>
        </div>
      </form>
    </div>
  </dialog>

  <template id="team-edit-player-template">
    <article class="player-card" data-team-edit-player>
      <header class="player-head">
        <span class="player-dorsal" data-dorsal aria-hidden="true">1</span>
        <span class="player-role" data-role>Titular</span>
        <div class="admin-player-order">
          <button type="button" data-move-up aria-label="Subir en el orden">↑</button>
          <button type="button" data-move-down aria-label="Bajar en el orden">↓</button>
        </div>
        <button type="button" class="player-remove" data-remove>Quitar</button>
      </header>
      <div class="player-grid">
        <div class="field admin-photo-field">
          <span class="admin-photo-label">Foto</span>
          <div class="admin-photo-row">
            <img class="admin-edit-photo" data-photo-preview alt="" hidden />
            <span class="admin-photo-thumb is-empty admin-edit-photo" data-photo-empty aria-hidden="true"></span>
            <div class="admin-photo-actions">
              <label class="add-player admin-photo-upload">
                Cambiar foto
                <input type="file" data-field="foto" accept="image/jpeg,image/png,image/webp" hidden />
              </label>
              <label class="admin-photo-delete">
                <input type="checkbox" data-field="eliminarFoto" />
                Eliminar foto
              </label>
            </div>
          </div>
          <p class="field-error" data-field-error="foto" hidden></p>
        </div>
        <div class="field">
          <label data-label="nombre">Nombre</label>
          <input type="text" data-field="nombre" maxlength="60" autocomplete="off" />
          <p class="field-error" data-field-error="nombre" hidden></p>
        </div>
        <div class="field">
          <label data-label="apellidos">Apellidos</label>
          <input type="text" data-field="apellidos" maxlength="80" autocomplete="off" />
          <p class="field-error" data-field-error="apellidos" hidden></p>
        </div>
        <div class="field">
          <label data-label="telefono">Móvil</label>
          <input type="tel" data-field="telefono" maxlength="18" autocomplete="off" />
          <p class="field-error" data-field-error="telefono" hidden></p>
        </div>
        <div class="field">
          <label data-label="email">Correo</label>
          <input type="email" data-field="email" maxlength="120" autocomplete="off" />
          <p class="field-error" data-field-error="email" hidden></p>
        </div>
        <div class="field">
          <label data-label="redSocial">Instagram u otra red <span class="field-opt">(opcional)</span></label>
          <input type="text" data-field="redSocial" maxlength="120" autocomplete="off" />
          <p class="field-error" data-field-error="redSocial" hidden></p>
        </div>
      </div>
    </article>
  </template>

  <SiteFooter />

  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  <script is:inline src="/assets/site-interactions.js" defer></script>
  <script is:inline src="/assets/match-utils.js" defer></script>
  <script is:inline src="/assets/admin.js" defer></script>
  <script is:inline src="/assets/admin-matches.js" defer></script>
  <script is:inline src="/assets/admin-ediciones.js" defer></script>
</BaseLayout>
