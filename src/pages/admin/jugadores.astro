---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  titulo="Jugadores"
  seccion="jugadores"
  lede="Todos los jugadores, de todos los equipos y ediciones. Desde aquí puedes darlos de alta sueltos y moverlos de equipo."
>
  <div class="admin-toolbar" slot="acciones">
    <button type="button" class="admin-btn admin-btn--primary" data-jugador-nuevo>+ Nuevo jugador</button>
  </div>

  <div class="admin-toolbar">
    <input
      type="search"
      class="admin-input admin-search"
      placeholder="Buscar por nombre, correo, móvil o equipo"
      aria-label="Buscar jugadores"
      data-admin-buscar
    />
    <select class="admin-select" style="width:auto" aria-label="Filtrar por equipo" data-filtro-equipo>
      <option value="">Todos los equipos</option>
    </select>
    <span class="admin-toolbar-sep"></span>
    <span class="admin-count" data-admin-contador></span>
  </div>

  <div data-admin-jugadores></div>

  <dialog class="admin-dialog" slot="dialogos" data-jugador-dialog>
    <div class="admin-dialog-shell">
      <div class="admin-dialog-head">
        <div>
          <h2 class="admin-dialog-title" data-jugador-titulo>Jugador</h2>
          <p class="admin-dialog-sub" data-jugador-sub></p>
        </div>
        <button type="button" class="admin-dialog-close" data-jugador-cerrar aria-label="Cerrar">×</button>
      </div>

      <div class="admin-dialog-body">
        <form class="admin-form" data-jugador-form novalidate>
          <div class="admin-field">
            <label for="jugador-equipo">Equipo</label>
            <select id="jugador-equipo" class="admin-select" data-jugador-field="equipoId"></select>
            <p class="admin-field-error" data-jugador-error="equipoId" hidden></p>
            <p class="admin-field-hint" data-jugador-aviso-equipo hidden>
              Al cambiar de equipo, el jugador pasa a la edición del equipo nuevo y entra al final de su plantilla.
            </p>
          </div>

          <div class="admin-form-grid">
            <div class="admin-field">
              <label for="jugador-nombre">Nombre</label>
              <input id="jugador-nombre" class="admin-input" type="text" maxlength="60" autocomplete="off"
                data-jugador-field="nombre" />
              <p class="admin-field-error" data-jugador-error="nombre" hidden></p>
            </div>
            <div class="admin-field">
              <label for="jugador-apellidos">Apellidos</label>
              <input id="jugador-apellidos" class="admin-input" type="text" maxlength="80" autocomplete="off"
                data-jugador-field="apellidos" />
              <p class="admin-field-error" data-jugador-error="apellidos" hidden></p>
            </div>
            <div class="admin-field">
              <label for="jugador-telefono">Móvil</label>
              <input id="jugador-telefono" class="admin-input" type="tel" maxlength="18" autocomplete="off"
                data-jugador-field="telefono" />
              <p class="admin-field-error" data-jugador-error="telefono" hidden></p>
            </div>
            <div class="admin-field">
              <label for="jugador-email">Correo</label>
              <input id="jugador-email" class="admin-input" type="email" maxlength="120" autocomplete="off"
                data-jugador-field="email" />
              <p class="admin-field-error" data-jugador-error="email" hidden></p>
            </div>
          </div>

          <div class="admin-field">
            <label for="jugador-red">Instagram u otra red <span class="admin-field-hint">(opcional)</span></label>
            <input id="jugador-red" class="admin-input" type="text" maxlength="120" autocomplete="off"
              data-jugador-field="redSocial" />
            <p class="admin-field-error" data-jugador-error="redSocial" hidden></p>
          </div>

          <div class="admin-field">
            <span class="admin-label">Foto</span>
            <div class="admin-photo-row">
              <img class="admin-photo-thumb admin-edit-photo" data-jugador-foto alt="" hidden />
              <span class="admin-photo-thumb is-empty admin-edit-photo" data-jugador-foto-vacia aria-hidden="true"></span>
              <div class="admin-photo-actions">
                <label class="admin-btn admin-btn--sm admin-photo-upload">
                  Cambiar foto
                  <input type="file" data-jugador-field="foto" accept="image/jpeg,image/png,image/webp" hidden />
                </label>
                <label class="admin-photo-delete">
                  <input type="checkbox" data-jugador-field="eliminarFoto" />
                  Eliminar foto
                </label>
              </div>
            </div>
            <p class="admin-field-error" data-jugador-error="foto" hidden></p>
          </div>
        </form>
      </div>

      <div class="admin-dialog-foot">
        <p class="admin-alert" role="alert" data-jugador-banner hidden></p>
        <button type="button" class="admin-btn" data-jugador-cancelar>Cancelar</button>
        <button type="button" class="admin-btn admin-btn--primary" data-jugador-guardar>Guardar jugador</button>
      </div>
    </div>
  </dialog>

  <script is:inline slot="scripts" src="/assets/admin/jugadores.js" defer></script>
</AdminLayout>
