---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  titulo="Heredado"
  seccion="heredado"
  lede="Tablas de la primera versión del sitio. Nadie escribe ya en ellas; están aquí solo para poder consultarlas."
>
  <p class="admin-note">
    El formulario antiguo guardaba en <code>inscripciones</code> y <code>reservas</code>. Hoy las inscripciones van a
    <code>equipos</code> y <code>jugadores</code>, y las camisetas a <code>camisetas_reservas</code>. Esta vista es de
    solo lectura: no se borra ni se modifica nada.
  </p>

  <section class="admin-card">
    <div class="admin-card-head">
      <h2 class="admin-card-title">Inscripciones antiguas</h2>
      <span class="admin-count" data-heredado-contador="inscripciones"></span>
    </div>
    <div data-heredado-inscripciones></div>
  </section>

  <section class="admin-card">
    <div class="admin-card-head">
      <h2 class="admin-card-title">Reservas antiguas</h2>
      <span class="admin-count" data-heredado-contador="reservas"></span>
    </div>
    <div data-heredado-reservas></div>
  </section>

  <script is:inline slot="scripts" src="/assets/admin/heredado.js" defer></script>
</AdminLayout>
