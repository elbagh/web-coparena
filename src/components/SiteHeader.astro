---
import LogoMark from "./LogoMark.astro";

/*
 * «Torneo» es un desplegable porque debajo cuelgan dos cosas distintas: lo que
 * pasa (el cuadro, que cambia cada partido) y lo que está pactado (premios y
 * reglas, que no cambia). Meterlas como dos entradas sueltas dejaría el nav en
 * seis enlaces y no diría que son la misma cosa.
 */
interface Enlace {
  href: string;
  label: string;
  /** Solo dentro de un desplegable, donde hay sitio para explicarse. */
  pista?: string;
}

interface Desplegable {
  label: string;
  hijos: Enlace[];
}

type Entrada = Enlace | Desplegable;

const esDesplegable = (item: Entrada): item is Desplegable => "hijos" in item;

const navItems: Entrada[] = [
  { href: "/donde-estamos/", label: "Dónde estamos" },
  {
    label: "Torneo",
    hijos: [
      { href: "/directo/", label: "En directo", pista: "El marcador del partido que se está jugando" },
      { href: "/torneo/", label: "El cuadro", pista: "Calendario, resultados y clasificación" },
      { href: "/torneo/premios/", label: "Premios y reglas", pista: "El reparto del bote y cómo se juega" }
    ]
  },
  { href: "/equipos/", label: "Equipos" },
  { href: "/jugadores/", label: "Jugadores" },
  { href: "/camisetas/", label: "Camisetas" }
];

/** Aplanado para el menú móvil, donde un desplegable dentro de otro no aporta nada. */
const navPlanos: Enlace[] = navItems.flatMap((item) => (esDesplegable(item) ? item.hijos : [item]));
---

<div class="header-backdrop" aria-hidden="true"></div>
<header class="site-header" aria-label="Cabecera principal">
  <div class="header-peak" aria-hidden="true">
    <svg viewBox="0 0 260 120" preserveAspectRatio="xMidYMax meet">
      <path
        d="M6 120 L80 22 L118 64 L140 40 L254 120 Z"
        stroke-linejoin="round"
        stroke-width="10"
      ></path>
    </svg>
  </div>

  <a class="brand" href="/" aria-label="La Copa Arena inicio">
    <span class="brand-mark"><LogoMark compact /></span>
    <span>La Copa Arena</span>
  </a>

  <nav class="nav-links" aria-label="Navegación principal">
    {
      navItems.map((item) =>
        esDesplegable(item) ? (
          <details class="nav-drop" data-nav-drop>
            <summary>
              {item.label}
              <svg class="nav-drop-flecha" viewBox="0 0 12 8" aria-hidden="true">
                <path d="M1 1.5 L6 6.5 L11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="nav-drop-panel">
              {item.hijos.map((hijo) => (
                <a href={hijo.href}>
                  <strong>{hijo.label}</strong>
                  <span>{hijo.pista}</span>
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      )
    }
  </nav>

  {/*
    El botón del directo son DOS elementos, no uno deshabilitado: un <a>
    deshabilitado no existe en HTML y seguiría siendo enfocable y clicable con
    teclado. Encendido es un enlace de verdad; apagado ya no es un <span> inerte
    porque ahora sí hace algo: contar que por ese hueco se seguirán los partidos,
    que apagado no se adivina.

    Y es un <details>, no un <button> con su JavaScript, por lo mismo que el menú
    móvil y el desplegable de «Torneo»: abre y cierra sin JavaScript, y header.js
    solo le añade lo que <details> no hace solo —cerrarse al pulsar fuera y con
    Escape—. De ahí el `data-nav-drop`.

    Y cuando está encendido enseña quién juega (siglas), no la palabra
    «directo» ni el marcador: sin saber de quién, un «12–9» no informa de
    nada, y el marcador está a un toque en /directo/.
  */}
  <div class="header-directo-wrap">
    <details class="directo-off" data-directo-apagado data-nav-drop>
      <summary class="header-directo is-apagado">
        <span class="directo-punto" aria-hidden="true"></span>
        <span data-directo-etiqueta>Offline</span>
      </summary>
      <p class="directo-aviso">Cuando empiece un partido, este botón te lleva al marcador en directo.</p>
    </details>

    <a class="header-directo is-vivo" href="/directo/" data-directo-vivo hidden aria-live="polite">
      <svg class="directo-llama" viewBox="0 0 16 20" aria-hidden="true">
        <path
          d="M8 0.6c.6 3.2-1.3 4.4-2.9 6C3.2 8.5 2 10.2 2 12.6 2 16.4 4.7 19.4 8 19.4s6-3 6-6.8c0-2.9-1.6-4.6-3.1-6.4-.5.9-1.2 1.5-2 1.8.6-2.7.2-5.4-.9-7.4Z"
          fill="currentColor"
        />
        <path d="M8 19.4c-1.8 0-3.2-1.6-3.2-3.6 0-1.9 1.5-2.8 2.3-4.3.8 1.3 2.1 2.2 2.1 3.6 0 1.4-.6 2.3-1.2 2.9Z" fill="var(--sun)" />
      </svg>
      <span class="directo-texto" data-directo-texto>En directo</span>
    </a>
  </div>

  <div class="header-join-wrap">
    <a class="header-join" href="/mi-equipo/">
      <svg class="join-ball" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="2.1"></circle>
        <path
          d="M3.4 8.7c5.3 2.3 11.9 2.3 17.2 0"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
        ></path>
        <path
          d="M12 2.9c-4.3 5.3-4.3 12.9 0 18.2"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>Mi zona</span>
    </a>
    <p class="nav-session" data-auth-logged-in hidden>
      Sesión iniciada como <strong data-auth-user-name></strong>
    </p>
  </div>

  <details class="mobile-menu" data-mobile-menu>
    <summary aria-label="Abrir menú de navegación">
      <span class="mobile-menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span>Menú</span>
    </summary>
    <nav class="mobile-menu-panel" aria-label="Navegación móvil">
      {navPlanos.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="mobile-menu-join" href="/mi-equipo/">Mi zona</a>
      <p class="mobile-menu-session" data-auth-logged-in hidden>
        Sesión iniciada como <strong data-auth-user-name></strong>
      </p>
    </nav>
  </details>
</header>
